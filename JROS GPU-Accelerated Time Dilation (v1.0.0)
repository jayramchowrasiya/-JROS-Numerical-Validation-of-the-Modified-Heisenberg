"""
Plot distribution of time dilation factors
"""
function plot_time_dilation_distribution(state::GPUTimeDilationState; save_path=nothing)
    flow_rates = Array(state.flow_rates)
    
    p = histogram(
        flow_rates,
        bins=50,
        xlabel="Time Flow Rate (x)",
        ylabel="Frequency",
        title="Distribution of Time Dilation Factors (N=$(state.n_states))",
        legend=false,
        fillcolor=:blue,
        fillalpha=0.6,
        linecolor=:darkblue,
        size=(1000, 600),
        dpi=300
    )
    
    # Add mean line
    vline!([mean(flow_rates)], linewidth=3, linecolor=:red, linestyle=:dash, label="Mean")
    
    if !isnothing(save_path)
        savefig(p, save_path)
        println("Plot saved to: $save_path")
    end
    
    return p
end

"""
Plot 2D heatmap of entropy vs consciousness effect on time dilation
"""
function plot_parameter_space(state::GPUTimeDilationState; save_path=nothing)
    entropy_cpu = Array(state.entropy)
    conscious_cpu = Array(state.conscious_intent)
    flow_cpu = Array(state.flow_rates)
    
    # Create 2D histogram
    p = scatter(
