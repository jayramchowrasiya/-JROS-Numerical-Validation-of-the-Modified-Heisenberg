end

"""
Export GPU state data to JSON
"""
function export_gpu_data(state::GPUTimeDilationState, filepath::String; sample_size::Int=1000)
    # Sample subset for export
    indices = rand(1:state.n_states, min(sample_size, state.n_states))
    
    export_data = Dict(
        "timestamp" => string(state.timestamp),
        "n_states" => state.n_states,
        "sample_size" => length(indices),
        "gpu_device" => string(CUDA.device()),
        "observers" => [
            Dict(
                "entropy" => Array(state.entropy)[i],
                "conscious_intent" => Array(state.conscious_intent)[i],
                "memory_depth" => Array(state.memory_depth)[i],
                "field_coupling" => Array(state.field_coupling)[i],
                "flow_rate" => Array(state.flow_rates)[i],
                "causality_index" => Array(state.causality_indices)[i],
                "probabilities" => Array(state.probabilities[:, i])
            )
            for i in indices
        ],
        "statistics" => Dict(
            "flow_rate" => Dict(
                "mean" => mean(Array(state.flow_rates)),
                "std" => std(Array(state.flow_rates)),
                "min" => minimum(Array(state.flow_rates)),
                "max" => maximum(Array(state.flow_rates))
            ),
            "causality" => Dict(
                "mean" => mean(Array(state.causality_indices)),
                "std" => std(Array(state.causality_indices))
            )
        )
    )
    
    open(filepath, "w") do f
        JSON.print(f, export_data, 4)
    end
    
    println("GPU data exported to: $filepath")
end

