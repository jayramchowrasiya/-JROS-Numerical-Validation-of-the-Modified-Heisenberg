"""
Calculate all temporal metrics on GPU
"""
function calculate_metrics!(state::GPUTimeDilationState)
    backend = get_backend(state.entropy)
    
    # Time dilation
    kernel! = calculate_time_dilation_kernel!(backend)
    kernel!(
        state.entropy,
        state.conscious_intent,
        state.memory_depth,
        state.flow_rates,
        ndrange=state.n_states
    )
    
    # Causality indices
    kernel_causality! = calculate_causality_kernel!(backend)
    kernel_causality!(
        state.entropy,
        state.conscious_intent,
        state.causality_indices,
        ndrange=state.n_states
    )
    
    # Probabilities
    kernel_probs! = calculate_probabilities_kernel!(backend)
    kernel_probs!(
        state.psi_states,
        state.probabilities,
        ndrange=state.n_states
    )
    
    synchronize(backend)
end

"""
Run parallel quantum evolution on GPU
"""
function evolve_gpu!(
    state::GPUTimeDilationState;
    duration::Float64=100e-9,
    n_steps::Int=100,
    verbose::Bool=true
)
    dt = Float32(duration / n_steps)
    backend = get_backend(state.psi_states)
    
    if verbose
        println("╔════════════════════════════════════════════════════════════╗")
        println("║     RUNNING GPU-ACCELERATED SIMULATION                     ║")
        println("╚════════════════════════════════════════════════════════════╝")
        println()
        println("Configuration:")
        println("  States:        $(state.n_states)")
        println("  Duration:      $(duration * 1e9) ns")
        println("  Time Steps:    $n_steps")
        println("  Δt:            $(dt * 1e9) ns")
        println()
    end
    
    # Allocate buffer for state swapping
    psi_buffer = similar(state.psi_states)
    
    # Progress bar
    prog = Progress(n_steps, desc="Evolving quantum states: ")
    
    # Time evolution loop
    for step in 1:n_steps
        kernel! = evolve_states_kernel!(backend)
        kernel!(
            state.psi_states,
            psi_buffer,
            state.H_real,
            state.H_imag,
            state.Γ,
            state.J,
            dt,
            ndrange=state.n_states
        )
        
        # Swap buffers
        state.psi_states, psi_buffer = psi_buffer, state.psi_states
        
        # Update progress
        next!(prog)
    end
    
    synchronize(backend)
    
    # Recalculate metrics
    calculate_metrics!(state)
    
    if verbose
        println()
        println("✅ Simulation Complete!")
        println()
    end
end

"""
Batch retrocausal probability calculation on GPU
"""
function calculate_retrocausal_batch(
    state::GPUTimeDilationState,
    time_deltas::Vector{Float64}
)
    backend = get_backend(state.entropy)
    
    time_deltas_gpu = cu(Float32.(time_deltas))
    retro_probs = CUDA.zeros(Float32, state.n_states, length(time_deltas))
    
    kernel! = calculate_retrocausal_kernel!(backend)
    kernel!(
        state.entropy,
        state.conscious_intent,
        state.memory_depth,
        time_deltas_gpu,
        retro_probs,
        ndrange=(state.n_states, length(time_deltas))
    )
    
    synchronize(backend)
    
    return Array(retro_probs)
end

