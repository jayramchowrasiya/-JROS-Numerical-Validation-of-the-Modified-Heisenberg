"""
Benchmark GPU performance
"""
function benchmark_gpu(n_states_list::Vector{Int}=[1000, 10000, 100000, 1000000])
    println("╔════════════════════════════════════════════════════════════╗")
    println("║     GPU PERFORMANCE BENCHMARK                               ║")
    println("╚════════════════════════════════════════════════════════════╝")
    println()
    
    results = []
    
    for n in n_states_list
        println("Testing with $n states...")
        
        # Initialize
        t_init = @elapsed state = initialize_gpu_system(n, verbose=false)
        
        # Evolution
        t_evolve = @elapsed evolve_gpu!(state, duration=100e-9, n_steps=100, verbose=false)
        
        # States per second
        states_per_sec = n / t_evolve
        
        push!(results, (n, t_init, t_evolve, states_per_sec))
        
        println("  Init time:     $(round(t_init, digits=3)) s")
        println("  Evolve time:   $(round(t_evolve, digits=3)) s")
        println("  Throughput:    $(round(states_per_sec / 1e6, digits=2)) M states/s")
        println()
    end
    
    return results
end

