"""
GPU kernel for parallel quantum state evolution
Each thread handles one quantum state in a batch
"""
@kernel function evolve_states_kernel!(
    @Const(ψ_in),           # Input states [4, N_states]
    ψ_out,                   # Output states [4, N_states]
    @Const(H_real),          # Hamiltonian real part [4, 4]
    @Const(H_imag),          # Hamiltonian imaginary part [4, 4]
    @Const(Γ),               # Decoherence rates [4, N_states]
    @Const(J),               # Conscious injection [4, 4]
    dt::Float32              # Time step
)
    i = @index(Global)
    
    # Each thread processes one quantum state
    if i <= size(ψ_in, 2)
        # Extract this state
        ψ0 = ψ_in[1, i]
        ψ1 = ψ_in[2, i]
        ψ2 = ψ_in[3, i]
        ψ3 = ψ_in[4, i]
        
        # Hamiltonian evolution: -iH|ψ⟩
        dψ0_h = -(H_imag[1,1]*ψ0 + H_imag[1,2]*ψ1 + H_imag[1,3]*ψ2 + H_imag[1,4]*ψ3) +
                 im*(H_real[1,1]*ψ0 + H_real[1,2]*ψ1 + H_real[1,3]*ψ2 + H_real[1,4]*ψ3)
        
        dψ1_h = -(H_imag[2,1]*ψ0 + H_imag[2,2]*ψ1 + H_imag[2,3]*ψ2 + H_imag[2,4]*ψ3) +
                 im*(H_real[2,1]*ψ0 + H_real[2,2]*ψ1 + H_real[2,3]*ψ2 + H_real[2,4]*ψ3)
        
        dψ2_h = -(H_imag[3,1]*ψ0 + H_imag[3,2]*ψ1 + H_imag[3,3]*ψ2 + H_imag[3,4]*ψ3) +
                 im*(H_real[3,1]*ψ0 + H_real[3,2]*ψ1 + H_real[3,3]*ψ2 + H_real[3,4]*ψ3)
        
        dψ3_h = -(H_imag[4,1]*ψ0 + H_imag[4,2]*ψ1 + H_imag[4,3]*ψ2 + H_imag[4,4]*ψ3) +
                 im*(H_real[4,1]*ψ0 + H_real[4,2]*ψ1 + H_real[4,3]*ψ2 + H_real[4,4]*ψ3)
        
        # Decoherence: -Γ|ψ⟩
        dψ0_γ = -Γ[1, i] * ψ0
        dψ1_γ = -Γ[2, i] * ψ1
        dψ2_γ = -Γ[3, i] * ψ2
        dψ3_γ = -Γ[4, i] * ψ3
        
        # Conscious injection: J|ψ⟩
        dψ0_j = J[1,1]*ψ0 + J[1,2]*ψ1 + J[1,3]*ψ2 + J[1,4]*ψ3
        dψ1_j = J[2,1]*ψ0 + J[2,2]*ψ1 + J[2,3]*ψ2 + J[2,4]*ψ3
        dψ2_j = J[3,1]*ψ0 + J[3,2]*ψ1 + J[3,3]*ψ2 + J[3,4]*ψ3
        dψ3_j = J[4,1]*ψ0 + J[4,2]*ψ1 + J[4,3]*ψ2 + J[4,4]*ψ3
        
        # Euler step
        ψ0_new = ψ0 + dt * (dψ0_h + dψ0_γ + dψ0_j)
        ψ1_new = ψ1 + dt * (dψ1_h + dψ1_γ + dψ1_j)
        ψ2_new = ψ2 + dt * (dψ2_h + dψ2_γ + dψ2_j)
        ψ3_new = ψ3 + dt * (dψ3_h + dψ3_γ + dψ3_j)
        
        # Normalize
        norm_sq = abs2(ψ0_new) + abs2(ψ1_new) + abs2(ψ2_new) + abs2(ψ3_new)
        norm_factor = sqrt(norm_sq)
        
        # Write back
        ψ_out[1, i] = ψ0_new / norm_factor
        ψ_out[2, i] = ψ1_new / norm_factor
        ψ_out[3, i] = ψ2_new / norm_factor
        ψ_out[4, i] = ψ3_new / norm_factor
    end
end

"""
GPU kernel to calculate probabilities from quantum states
"""
@kernel function calculate_probabilities_kernel!(
    @Const(ψ),              # Quantum states [4, N_states]
    probs                    # Output probabilities [4, N_states]
)
    i = @index(Global)
    
    if i <= size(ψ, 2)
        probs[1, i] = abs2(ψ[1, i])
        probs[2, i] = abs2(ψ[2, i])
        probs[3, i] = abs2(ψ[3, i])
        probs[4, i] = abs2(ψ[4, i])
    end
end

"""
GPU kernel for time dilation calculation across many observers
"""
@kernel function calculate_time_dilation_kernel!(
    @Const(entropy),         # Observer entropies [N_observers]
    @Const(conscious),       # Conscious intents [N_observers]
    @Const(memory),          # Memory depths [N_observers]
    flow_rates               # Output flow rates [N_observers]
)
    i = @index(Global)
    
    if i <= length(entropy)
        Θ = entropy[i]
        C = conscious[i]
        γ = memory[i]
        
        flow_rates[i] = exp(Θ * (1.0f0 - C * γ))
    end
end

"""
GPU kernel for causality index calculation
"""
@kernel function calculate_causality_kernel!(
    @Const(entropy),
    @Const(conscious),
    causality_indices
)
    i = @index(Global)
    
    if i <= length(entropy)
        Θ = entropy[i]
        C = conscious[i]
        
        causality_indices[i] = max(0.0f0, 1.0f0 - Θ/3.0f0) * (0.5f0 + 0.5f0 * C) * 100.0f0
    end
end

"""
GPU kernel for retrocausal probability calculation
"""
@kernel function calculate_retrocausal_kernel!(
    @Const(entropy),
    @Const(conscious),
    @Const(memory),
    @Const(time_deltas),     # Time differences [N_times]
    retro_probs              # Output [N_observers, N_times]
)
    i, j = @index(Global, NTuple)
    
    if i <= length(entropy) && j <= length(time_deltas)
        Θ = entropy[i]
        C = conscious[i]
        γ = memory[i]
        Δt = time_deltas[j]
        
        retro_probs[i, j] = γ * exp(-Θ * abs(Δt)) * C * 100.0f0
    end
end

