"""
Print GPU system statistics
"""
function print_gpu_statistics(state::GPUTimeDilationState)
    # Transfer data to CPU for analysis
    flow_rates_cpu = Array(state.flow_rates)
    causality_cpu = Array(state.causality_indices)
    probs_cpu = Array(state.probabilities)
    
    println("═══ BATCH STATISTICS ($(state.n_states) states) ═══")
    println()
    
    println("Time Flow Rate:")
    println("  Mean:          $(mean(flow_rates_cpu)) x")
    println("  Std Dev:       $(std(flow_rates_cpu)) x")
    println("  Min:           $(minimum(flow_rates_cpu)) x")
    println("  Max:           $(maximum(flow_rates_cpu)) x")
    println()
    
    println("Causality Index:")
    println("  Mean:          $(mean(causality_cpu)) %")
    println("  Std Dev:       $(std(causality_cpu)) %")
    println("  Min:           $(minimum(causality_cpu)) %")
    println("  Max:           $(maximum(causality_cpu)) %")
    println()
    
    println("Average State Probabilities:")
    for i in 1:4
        labels = ["|0⟩ (Void)", "|1⟩ (Identity)", "|π⟩ (Oscillation)", "|∞⟩ (Field)"]
        println("  $(labels[i]): $(mean(probs_cpu[i, :]) * 100)%")
    end
    println()
end

