"""
GPU-accelerated time dilation state
"""
mutable struct GPUTimeDilationState
    # Observer parameters (on GPU)
    entropy::CuArray{Float32, 1}
    conscious_intent::CuArray{Float32, 1}
    memory_depth::CuArray{Float32, 1}
    field_coupling::CuArray{Float32, 1}
    
    # Quantum states (on GPU)
    psi_states::CuArray{ComplexF32, 2}  # [4, N_states]
    
    # Computed metrics (on GPU)
    flow_rates::CuArray{Float32, 1}
    causality_indices::CuArray{Float32, 1}
    probabilities::CuArray{Float32, 2}   # [4, N_states]
    
    # Operators (on GPU)
    H_real::CuArray{Float32, 2}
    H_imag::CuArray{Float32, 2}
    Γ::CuArray{Float32, 2}
    J::CuArray{Float32, 2}
    
    # Metadata
    n_states::Int
    timestamp::DateTime
end

